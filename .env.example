# Port for Express Server
PORT=3000

# Gemini API Key (get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth Credentials for Google Calendar Integration (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Web Push VAPID Keys for Phone Notifications
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:contacto@medfamilia.app

# JWT Secret for Session Security
JWT_SECRET=cambiar_por_una_clave_secreta_segura_2026
